# このファイルは .env.local のテンプレートです（Gitに含めてOK）
# 実際の値は .env.local にコピーして記入し、絶対にコミットしないこと

# ===== Phase 2 以降：Supabase =====
# Supabase プロジェクトの URL と Publishable key
# 取得元: Supabase Dashboard → Project Settings → API Keys
# 注意:
#  - Publishable key（sb_publishable_...）が現行の標準。旧 anon key（eyJ... の JWT）は legacy。
#  - どちらもフロント公開前提のキーなので VITE_ を付けてOK。守るのはキーの秘匿ではなく RLS。
#  - Secret key（sb_secret_...・旧 service_role）は絶対にここへ書かない（サーバー専用）。
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxx...

# ===== Phase 3 以降：OpenAI =====
# OpenAI API キー（Vercel Serverless Functions でのみ使用）
# 注意: VITE_ プレフィックスを絶対につけないこと（フロントに露出する）
# 取得元: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxx...
